diff --git a/libc/arch-arm/bionic/kill.S b/libc/arch-arm/bionic/kill.S
index 2954091..f10816c 100644
--- a/libc/arch-arm/bionic/kill.S
+++ b/libc/arch-arm/bionic/kill.S
@@ -44,6 +44,16 @@
     .align 4
 
 kill:
+    /* gb-gate (M1): when the gate is on, translate a virtual pid
+       argument back to the real pid before the svc. */
+    ldr     ip, =__gb_gate_mode
+    ldrb    ip, [ip]
+    cmp     ip, #1
+    bne     10f
+    stmfd   sp!, {r1, lr}
+    bl      __gb_gate_fix_pid
+    ldmfd   sp!, {r1, lr}
+10:
     stmfd   sp!, {r4-r7, ip, lr}
     ldr     r7, =__NR_kill
     swi     #0
diff --git a/libc/arch-arm/bionic/syscall.S b/libc/arch-arm/bionic/syscall.S
index ada12a6..485c1a2 100644
--- a/libc/arch-arm/bionic/syscall.S
+++ b/libc/arch-arm/bionic/syscall.S
@@ -39,6 +39,66 @@
 #if __ARM_EABI__
 
 syscall:
+    /* gb-gate (M1): route through the compat dispatcher unless the
+       gate has settled to "off" (GBROOT unset); the off path below
+       (label 10) is the original instruction sequence verbatim. */
+    ldr     ip, =__gb_gate_mode
+    ldrb    ip, [ip]
+    cmp     ip, #2
+    beq     10f
+    mov     ip, sp
+    stmfd   sp!, {r4, r5, r6, r7, lr}
+    sub     sp, sp, #52
+    str     r1, [sp, #0]
+    str     r2, [sp, #4]
+    str     r3, [sp, #8]
+    ldr     r4, [ip, #0]
+    str     r4, [sp, #12]
+    ldr     r4, [ip, #4]
+    str     r4, [sp, #16]
+    ldr     r4, [ip, #8]
+    str     r4, [sp, #20]
+    mov     r4, #0
+    str     r4, [sp, #24]
+    str     r4, [sp, #28]
+    str     r0, [sp, #44]
+    mov     r1, sp
+    add     r2, sp, #32
+    bl      __gb_gate_pre
+    str     r0, [sp, #36]
+    tst     r0, #1
+    bne     20f
+    ldr     r0, [sp, #0]
+    ldr     r1, [sp, #4]
+    ldr     r2, [sp, #8]
+    ldr     r3, [sp, #12]
+    ldr     r4, [sp, #16]
+    ldr     r5, [sp, #20]
+    ldr     r7, [sp, #44]
+    swi     #0
+    str     r0, [sp, #40]
+    b       30f
+20:
+    ldr     r0, [sp, #32]
+    str     r0, [sp, #40]
+30:
+    ldr     r3, [sp, #36]
+    tst     r3, #2
+    bne     40f
+    ldr     r2, [sp, #40]
+    mov     r1, sp
+    ldr     r0, [sp, #44]
+    bl      __gb_gate_post
+    b       50f
+40:
+    ldr     r0, [sp, #40]
+50:
+    add     sp, sp, #52
+    ldmfd   sp!, {r4, r5, r6, r7, lr}
+    movs    r0, r0
+    bxpl    lr
+    b       __set_syscall_errno
+10:
     mov     ip, sp
     stmfd	sp!, {r4, r5, r6, r7}
     mov     r7, r0
