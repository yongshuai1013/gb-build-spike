+static long gb_raw_sigsuspend(const unsigned long *mask)
+{
+    /* rt_sigsuspend(mask, sigsetsize); the kernel sigset is 8 bytes. */
+    return gb_raw6(__NR_rt_sigsuspend, (long) mask, 8, 0, 0, 0, 0);
+}
+
+/* pause()/sigsuspend() emulation: the legacy numbers (29/72) are not
+ * in the host app seccomp allowlist, rt_sigsuspend is. With mask==0
+ * the caller's current mask is used (pause semantics); otherwise the
+ * given 64-bit mask applies (sigsuspend semantics: the mask value the
+ * legacy call passes in a register occupies the low word). Returns
+ * -EINTR, the only way either call ever returns. */
+static long gb_wait_signal(const unsigned long *mask)
+{
+    unsigned long m[2];
+    if (mask) {
+        m[0] = mask[0];
+        m[1] = mask[1];
+    } else {
+        m[0] = 0;
+        m[1] = 0;
+        gb_raw6(__NR_rt_sigprocmask, 0 /* how ignored, set==NULL */,
+                0, (long) m, 8, 0, 0);
+    }
+    gb_raw_sigsuspend(m);
+    return -EINTR;
+}
