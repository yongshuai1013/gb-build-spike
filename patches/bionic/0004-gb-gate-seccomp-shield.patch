+    /* ---- host seccomp shield ----
+     * The host app's seccomp filter answers a denied syscall with
+     * SIGSYS at the entry point, before any kernel permission check
+     * could produce EPERM (this is what killed the M1 guest init 3ms
+     * into its first run: its first mount() was issued raw). Nothing
+     * on the modern app blocklist - and nothing modern bionic dropped
+     * from its syscall table, which is denied by default - may fall
+     * through to the raw svc. Fakes return success: mounts and id
+     * changes are fiction in the guest model anyway (paths are
+     * translated into the rootfs, getuid() reports 0). Rewrites
+     * retarget the svc by storing the new number in args[11], the
+     * frame slot every stub reloads r7 from after pre(). reboot is
+     * faked for the same reason: init calls android_reboot() when a
+     * critical service crash-loops, and a guest must neither reboot
+     * the host nor die asking for it. */
+    switch (nr) {
+    case __NR_mount:
+#ifdef __NR_umount
+    case __NR_umount:
+#endif
+    case __NR_umount2:
+    case __NR_reboot:
+    case __NR_settimeofday:
+    case __NR_sethostname:
+    case __NR_setdomainname:
+    case __NR_setuid32:
+    case __NR_setgid32:
+    case __NR_setreuid32:
+    case __NR_setregid32:
+    case __NR_setresgid32:
+    case __NR_setgroups32:
+#ifdef __NR_ioprio_set
+    case __NR_ioprio_set:
+    case __NR_ioprio_get:
+#endif
+        *skip_result = 0;
+        __gb_gate_handled++;
+        return GB_ACT_SKIP_SVC | GB_ACT_SKIP_POST;
+    case __NR_pause:
+        *skip_result = gb_wait_signal(0);
+        __gb_gate_handled++;
+        return GB_ACT_SKIP_SVC | GB_ACT_SKIP_POST;
+    case __NR_sigsuspend: {
+        unsigned long m[2];
+        m[0] = (unsigned long) args[2];
+        m[1] = 0;
+        *skip_result = gb_wait_signal(m);
+        __gb_gate_handled++;
+        return GB_ACT_SKIP_SVC | GB_ACT_SKIP_POST;
+    }
+    case __NR_sigprocmask:
+        /* Legacy 3-arg form; the rt form appends sigsetsize. Bionic
+         * sigset_t is 64-bit, matching the kernel's 8-byte set. */
+        args[3] = 8;
+        args[11] = __NR_rt_sigprocmask;
+        return 0;
+    case __NR_sigpending:
